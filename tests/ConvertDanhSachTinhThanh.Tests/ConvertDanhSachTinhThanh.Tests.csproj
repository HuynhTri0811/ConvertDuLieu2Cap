<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Linked app sources are .NET Framework code written without nullable annotations. -->
    <NoWarn>$(NoWarn);CS8618;CS8625;CS8603</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <AppDir>..\..\src\ConvertDanhSachTinhThanh\</AppDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <!-- Platform-independent app sources (no WinForms, no SQL Server). -->
  <ItemGroup>
    <Compile Include="$(AppDir)Constants\AppConstants.cs" Link="App\Constants\AppConstants.cs" />
    <Compile Include="$(AppDir)Helpers\*.cs" Link="App\Helpers\%(Filename)%(Extension)" />
    <Compile Include="$(AppDir)Model\*.cs" Link="App\Model\%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- Catalog data files, copied with the same layout the app uses at runtime. -->
  <ItemGroup>
    <None Include="$(AppDir)Data\**\*.xml" Link="Data\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
